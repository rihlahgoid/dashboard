rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hanya email yang terdaftar di bawah ini yang boleh membaca & menulis.
    // GANTI kedua email dengan email Anda dan teman Anda (huruf kecil semua).
    function diizinkan() {
      return request.auth != null
        && request.auth.token.email in ['rihlahgo.id@gmail.com', 'kurniawan.zakyoneal@gmail.com'];
    }
    match /{document=**} {
      allow read, write: if diizinkan();
    }
  }
}
